# ---- 用 docker compose 部署时（推荐）----
# 两个密码都换成随机长字符串，例如：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ---- 不用 Docker、直接运行 node server/index.ts 时 ----
# DATABASE_URL=mysql://mylog:你的密码@localhost:3306/mylog
# PORT=8787
# HOST=127.0.0.1
# 部署在 Nginx 等反向代理后面时设为 1，登录失败次数限制才能按真实 IP 计算
# TRUST_PROXY=1
