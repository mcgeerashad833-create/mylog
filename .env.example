# 复制成 .env 后填写（docker compose 和直接运行 node server/index.ts 都读这里的设置）

# 云数据库连接串（MySQL 8，utf8mb4）：mysql://账号:密码@地址:3306/库名
# - 云服务器和数据库在同一地域时，用数据库的「内网地址」
# - 密码里有 @ : / ? # % 等符号时要做 URL 编码，例如 @ 写成 %40
# - 只能走公网时要开启 SSL，见 docs/02-部署.md「走公网连接」
DATABASE_URL=mysql://mylog:改成你的密码@改成数据库地址:3306/mylog

# 部署在 Nginx 等反向代理后面时设为 1，登录失败次数限制才能按真实 IP 计算（docker compose 里已经设好）
# TRUST_PROXY=1

# 不用 Docker、直接运行时的监听地址
# PORT=8787
# HOST=127.0.0.1

# 走公网连接云数据库时，云厂商 CA 证书的路径（docker compose 里已映射好，见 docker-compose.yml）
# DATABASE_CA_FILE=/path/to/db-ca.pem
